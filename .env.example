# Copy this file to .env and replace every value with a strong secret.
# .env is gitignored - never commit real secrets.

# Environment
ASPNETCORE_ENVIRONMENT=Development

# SQL Server SA password. Must match the password the sqlserver_data volume was
# first created with (SQL Server fixes the SA password at first initialization).
MSSQL_SA_PASSWORD=change-me-strong-sa-password

# JWT signing key. MUST be at least 32 characters of high-entropy random data.
# Generate one, e.g.:  openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-of-at-least-32-characters
JWT_ISSUER=ServerPanel
JWT_AUDIENCE=ServerPanelUsers

# Initial admin account password. Used only when seeding a fresh database.
# If unset, a random password is generated and printed once at first startup.
ADMIN_PASSWORD=change-me-strong-admin-password

# Frontend
VITE_API_URL=http://localhost:5000/api
